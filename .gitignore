# Downloads and caches the scripts re-create (.kb_cache holds ~200 MB of game data, price hours and icons)
.kb_cache/

# Self-test output: the full runs are ~20 MB each; keep the markdown reports and the latest summary
reports/*.json
reports/*.log
reports/*.jsonl
reports/sweep-progress.txt
!reports/selftest-latest.json
!reports/sweep-summary.json

# Build output (node app/build.js); the artifact is published from it
app/dist/
# The price package scripts/build_price_package.py writes (the GitHub Actions job publishes it to npm)
npm/

# Local settings and editor/OS files
.claude/settings.local.json
__pycache__/
*.pyc
Thumbs.db
.DS_Store

# The desktop program (desktopuild.cmd writes it)
desktop/out/

# crafter video transcripts the player collected (other people's content: not for the repository)
transcripts/
